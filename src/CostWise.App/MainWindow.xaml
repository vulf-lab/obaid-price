<Window x:Class="CostWise.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OBAID Pricing"
        Height="780" Width="1280"
        MinHeight="640" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/obaid-pricing-logo.png"
        Background="{StaticResource ContentBgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,28,20,20">
                    <Image Source="pack://application:,,,/Assets/obaid-pricing-logo-dark.png"
                           Width="56" Height="56"
                           Stretch="Uniform"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,14"/>
                    <TextBlock Text="OBAID Pricing" FontSize="24" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                    <TextBlock Text="Feed formulation &amp; costing" Foreground="#9BB0B7" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <ListBox x:Name="NavList"
                         ItemsSource="{Binding NavItems}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="NavList_OnPreviewMouseLeftButtonDown"
                         PreviewMouseMove="NavList_OnPreviewMouseMove"
                         Drop="NavList_OnDrop"
                         DragOver="NavList_OnDragOver">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NavButtonStyle}"
                                    Command="{Binding DataContext.NavigateToItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding IconGlyph}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Width="24"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding CurrentPageTitle}" Style="{StaticResource PageTitleStyle}"/>
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>
