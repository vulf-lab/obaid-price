<Window x:Class="CostWise.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CostWise"
        Height="780" Width="1280"
        MinHeight="640" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ContentBgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,28,20,24">
                    <TextBlock Text="CostWise" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Feed formulation &amp; costing" Foreground="#9BB0B7" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel>
                    <Button Content="Formulations" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateFormulationsCommand}"/>
                    <Button Content="Production" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateProductionCommand}"/>
                    <Button Content="Raw Ingredients" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateRawIngredientsCommand}"/>
                    <Button Content="Specifications" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateSpecificationsCommand}"/>
                    <Button Content="Pricing" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigatePricingCommand}"/>
                    <Button Content="Settings" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateSettingsCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding CurrentPageTitle}" Style="{StaticResource PageTitleStyle}"/>
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>
