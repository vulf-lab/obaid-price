<UserControl x:Class="CostWise.App.Controls.ExcelColumnFilterHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <DockPanel LastChildFill="True">
            <ToggleButton x:Name="FilterButton"
                          DockPanel.Dock="Right"
                          Content="▾"
                          Padding="4,0"
                          Margin="4,0,0,0"
                          Background="Transparent"
                          BorderThickness="0"
                          Cursor="Hand"
                          Foreground="{StaticResource TextMutedBrush}"
                      Click="FilterButton_OnClick"/>
            <TextBlock Text="{Binding Title, ElementName=Root}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
        </DockPanel>
        <Popup x:Name="FilterPopup"
               PlacementTarget="{Binding ElementName=FilterButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="1"
                    Padding="10"
                    MinWidth="200"
                    MaxHeight="320">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Button Content="Sort A → Z" Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,4" Click="SortAsc_OnClick"/>
                        <Button Content="Sort Z → A" Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="SortDesc_OnClick"/>
                    </StackPanel>
                    <StackPanel x:Name="ValueFilterActions" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Select all" Style="{StaticResource SecondaryButtonStyle}" Click="SelectAll_OnClick" Margin="0,0,4,0"/>
                        <Button Content="Clear" Style="{StaticResource SecondaryButtonStyle}" Click="Clear_OnClick" Margin="0,0,4,0"/>
                        <Button Content="Apply" Style="{StaticResource PrimaryButtonStyle}" Click="Apply_OnClick"/>
                    </StackPanel>
                    <ScrollViewer x:Name="ValueFilterScroll" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="OptionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Value}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
