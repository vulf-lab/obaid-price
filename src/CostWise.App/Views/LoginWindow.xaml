<Window x:Class="CostWise.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in — OBAID Pricing"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/obaid-pricing-logo.png"
        Background="{StaticResource ContentBgBrush}"
        KeyDown="Window_OnKeyDown">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E8EFE9" Offset="0"/>
                <GradientStop Color="#F3F1EC" Offset="0.45"/>
                <GradientStop Color="#E4E0D8" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Button Content="&#xE8BB;"
                FontFamily="Segoe MDL2 Assets"
                FontSize="14"
                Width="40" Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,16,16,0"
                Background="Transparent"
                BorderThickness="0"
                Foreground="{StaticResource TextMutedBrush}"
                Cursor="Hand"
                ToolTip="Close"
                Click="Close_OnClick"/>

        <Border MaxWidth="420"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="32"
                Style="{StaticResource CardBorderStyle}"
                Padding="36,40">
            <StackPanel>
                <Image Source="pack://application:,,,/Assets/obaid-pricing-logo.png"
                       Width="88" Height="88"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>
                <TextBlock Text="OBAID Pricing"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Feed formulation &amp; costing"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,28"/>

                <!-- First-run setup -->
                <StackPanel Visibility="{Binding IsSetupMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Create your local password"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="This password protects the app on this PC. It is stored as a salted hash (never in plain text)."
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"/>
                    <TextBlock Text="Email"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Email}"
                             Margin="0,0,0,14"
                             IsReadOnly="True"
                             Background="#F7F5F1"/>
                    <TextBlock Text="Password"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,4"/>
                    <PasswordBox x:Name="SetupPasswordBox"
                                 Margin="0,0,0,14"
                                 Padding="8,6"
                                 BorderBrush="{StaticResource BorderSoftBrush}"
                                 BorderThickness="1"
                                 KeyDown="CredentialBox_OnKeyDown"/>
                    <TextBlock Text="Confirm password"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,4"/>
                    <PasswordBox x:Name="SetupConfirmBox"
                                 Margin="0,0,0,18"
                                 Padding="8,6"
                                 BorderBrush="{StaticResource BorderSoftBrush}"
                                 BorderThickness="1"
                                 KeyDown="CredentialBox_OnKeyDown"/>
                    <Button Content="Create password &amp; continue"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="14,12"
                            Click="Setup_OnClick"/>
                </StackPanel>

                <!-- Damaged account -->
                <StackPanel Visibility="{Binding IsDamagedMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"/>
                    <Button Content="Reset local account"
                            Style="{StaticResource DangerButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="14,12"
                            Command="{Binding ResetDamagedAccountCommand}"/>
                </StackPanel>

                <!-- Password login -->
                <StackPanel Visibility="{Binding IsPasswordMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Email"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,14"
                             IsReadOnly="True"
                             Background="#F7F5F1"/>

                    <TextBlock Text="Password"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Margin="0,0,0,14"
                                 Padding="8,6"
                                 BorderBrush="{StaticResource BorderSoftBrush}"
                                 BorderThickness="1"
                                 KeyDown="CredentialBox_OnKeyDown"/>

                    <CheckBox Content="Remember me (PIN unlock if set; otherwise password still required)"
                              IsChecked="{Binding RememberMe}"
                              Margin="0,0,0,18"
                              Foreground="{StaticResource TextPrimaryBrush}"/>

                    <Button Content="Sign in"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="14,12"
                            Click="SignIn_OnClick"/>
                </StackPanel>

                <!-- PIN unlock -->
                <StackPanel Visibility="{Binding IsPinMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Enter your PIN to unlock"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               HorizontalAlignment="Center"/>
                    <PasswordBox x:Name="PinBox"
                                 Margin="0,0,0,18"
                                 Padding="8,6"
                                 MaxLength="8"
                                 BorderBrush="{StaticResource BorderSoftBrush}"
                                 BorderThickness="1"
                                 KeyDown="CredentialBox_OnKeyDown"/>
                    <Button Content="Unlock"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="14,12"
                            Margin="0,0,0,10"
                            Click="Unlock_OnClick"/>
                    <Button Content="Use password instead"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Command="{Binding UsePasswordInsteadCommand}"/>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           Visibility="{Binding IsDamagedMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
