<UserControl x:Class="CostWise.App.Views.ComparisonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                   Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ToolbarIconButtonStyle}"
                        Command="{Binding ClearSelectionCommand}"
                        ToolTip="Clear comparison selection">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71C;" Style="{StaticResource ToolbarGlyphStyle}"/>
                        <TextBlock Text="Clear" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarIconButtonStyle}" Margin="6,0,0,0"
                        Command="{Binding LoadCommand}"
                        ToolTip="Refresh">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource ToolbarGlyphStyle}"/>
                        <TextBlock Text="Refresh" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarIconButtonStyle}" Margin="6,0,0,0"
                        Command="{Binding SortColumnsAscendingCommand}"
                        IsEnabled="{Binding CanSortColumns}"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Sort formula columns ascending by selected nutrient row">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74A;" Style="{StaticResource ToolbarGlyphStyle}"/>
                        <TextBlock Text="↑ Columns" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarIconButtonStyle}" Margin="6,0,0,0"
                        Command="{Binding SortColumnsDescendingCommand}"
                        IsEnabled="{Binding CanSortColumns}"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Sort formula columns descending by selected nutrient row">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74B;" Style="{StaticResource ToolbarGlyphStyle}"/>
                        <TextBlock Text="↓ Columns" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarIconButtonStyle}" Margin="6,0,0,0"
                        Command="{Binding ResetNutrientFiltersCommand}"
                        Visibility="{Binding IsProfilesMode, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Clear nutrient filters">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71C;" Style="{StaticResource ToolbarGlyphStyle}"/>
                        <TextBlock Text="Reset" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarIconButtonStyle}" Margin="6,0,0,0"
                        Command="{Binding PrintProfilesCommand}"
                        IsEnabled="{Binding CanPrintProfiles}"
                        Visibility="{Binding IsProfilesMode, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Print comparison as landscape PDF">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE749;" Style="{StaticResource ToolbarGlyphStyle}"/>
                        <TextBlock Text="Print" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Style="{StaticResource ToolbarClusterStyle}" HorizontalAlignment="Left" Orientation="Horizontal">
                <Border Style="{StaticResource ToolbarModeToggleBorderStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Profiles" Margin="4,0" GroupName="CompareMode"
                                     IsChecked="{Binding IsProfilesMode, Mode=OneWay}"
                                     Command="{Binding SetProfilesModeCommand}"/>
                        <RadioButton Content="Formulations" Margin="8,0,4,0" GroupName="CompareMode"
                                     IsChecked="{Binding IsFormulationsMode, Mode=OneWay}"
                                     Command="{Binding SetFormulationsModeCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Chips}" Margin="0,0,0,10"
                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource BorderSoftBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="8,4" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Code}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Content="×" Padding="4,0" BorderThickness="0" Background="Transparent"
                                    Command="{Binding DataContext.RemoveChipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Remove from compare"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid>
            <!-- Profiles mode -->
            <Border Style="{StaticResource CardBorderStyle}"
                    Visibility="{Binding IsProfilesMode, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Nutrition targets" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid x:Name="ProfileNutrientGrid"
                              ItemsSource="{Binding FilteredNutrientRows}"
                              SelectedItem="{Binding SelectedNutrientRow}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              ColumnHeaderHeight="56"
                              Loaded="ProfileNutrientGrid_OnLoaded">
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D6EAF8"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A1A1A"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E8F4FC"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A1A1A"/>
                        </DataGrid.Resources>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Formulations mode -->
            <Grid Visibility="{Binding IsProfilesMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardBorderStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Ingredients (%)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <DataGrid x:Name="IngredientGrid"
                                  ItemsSource="{Binding IngredientRows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  Loaded="IngredientGrid_OnLoaded">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D6EAF8"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A1A1A"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E8F4FC"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A1A1A"/>
                            </DataGrid.Resources>
                        </DataGrid>
                    </DockPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Nutrition targets" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <DataGrid x:Name="FormulaNutrientGrid"
                                  ItemsSource="{Binding NutrientRows}"
                                  SelectedItem="{Binding SelectedNutrientRow}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  Loaded="FormulaNutrientGrid_OnLoaded">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D6EAF8"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A1A1A"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E8F4FC"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A1A1A"/>
                            </DataGrid.Resources>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
