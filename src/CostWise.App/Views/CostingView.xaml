<UserControl x:Class="CostWise.App.Views.CostingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}"/>
                            <Button Content="Save scenario" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Command="{Binding SaveScenarioCommand}"/>
                        </StackPanel>

                        <TextBlock Text="Formulation" Foreground="{StaticResource TextMutedBrush}"/>
                        <ComboBox ItemsSource="{Binding Formulations}" SelectedItem="{Binding SelectedFormulation}"
                                  DisplayMemberPath="Code" Margin="0,0,0,12"/>

                        <TextBlock Text="Scenario name" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding ScenarioName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <TextBlock Text="Market" Foreground="{StaticResource TextMutedBrush}"/>
                        <ComboBox ItemsSource="{Binding Markets}" SelectedItem="{Binding Market}" Margin="0,0,0,12"/>

                        <TextBlock Text="Packing" Foreground="{StaticResource TextMutedBrush}"/>
                        <ComboBox ItemsSource="{Binding PackingChoices}"
                                  SelectedItem="{Binding SelectedPackingChoice}"
                                  DisplayMemberPath="Label"
                                  Margin="0,0,0,12"/>

                        <StackPanel Visibility="{Binding IsExport, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Export documents" Foreground="{StaticResource TextMutedBrush}"/>
                            <ComboBox ItemsSource="{Binding DocumentChoices}"
                                      SelectedItem="{Binding SelectedDocumentChoice}"
                                      DisplayMemberPath="Label"
                                      Margin="0,0,0,12"/>
                        </StackPanel>

                        <TextBlock Text="Additive (optional)" Foreground="{StaticResource TextMutedBrush}"/>
                        <ComboBox ItemsSource="{Binding AdditiveChoices}"
                                  SelectedItem="{Binding SelectedAdditiveChoice}"
                                  DisplayMemberPath="Label"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="Transportation (optional)" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding TransportationCost, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <TextBlock Text="Margin %" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding MarginPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <TextBlock Text="Display unit" Foreground="{StaticResource TextMutedBrush}"/>
                        <ComboBox ItemsSource="{Binding PriceUnitOptions}"
                                  SelectedItem="{Binding SelectedPriceUnitOption}"
                                  DisplayMemberPath="Label"
                                  Margin="0,0,0,12"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding LiveCostingTitle}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Raw material"/>
                            <TextBlock Grid.Column="1" Text="{Binding DisplayRmCost, Converter={StaticResource MoneyFormat}}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Text="Conversion"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DisplayConversionCost, Converter={StaticResource MoneyFormat}}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="2" Text="Packing"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DisplayPackingCost, Converter={StaticResource MoneyFormat}}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="3" Text="Export docs"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DisplayAppliedExportDoc, Converter={StaticResource MoneyFormat}}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="4" Text="Total cost" Margin="0,8,0,0" FontSize="16"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DisplayTotalCost, Converter={StaticResource MoneyFormat}}" Margin="0,8,0,0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Grid.Row="5" Text="Selling price" Margin="0,4,0,0" FontSize="16"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DisplaySellingPrice, Converter={StaticResource MoneyFormat}}" Margin="0,4,0,0" FontSize="16" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Saved scenarios (snapshots)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <DataGrid x:Name="ScenariosGrid"
                                  ItemsSource="{Binding SavedScenarios}"
                                  IsReadOnly="True"
                                  Loaded="ScenariosGrid_OnLoaded"
                                  Unloaded="ScenariosGrid_OnUnloaded">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" MinWidth="120"/>
                                <DataGridTextColumn Header="Formula" Binding="{Binding Formulation.Code}" Width="90" MinWidth="70"/>
                                <DataGridTextColumn Header="Market" Binding="{Binding Market}" Width="90" MinWidth="70"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding SnapshotTotalCost, Converter={StaticResource MoneyFormat}}" Width="90" MinWidth="70"/>
                                <DataGridTextColumn Header="Sell" Binding="{Binding SnapshotSellingPrice, Converter={StaticResource MoneyFormat}}" Width="90" MinWidth="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
