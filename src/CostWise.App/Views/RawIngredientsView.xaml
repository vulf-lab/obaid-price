<UserControl x:Class="CostWise.App.Views.RawIngredientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CostWise.App.Controls">
    <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
        <Border Style="{StaticResource CardBorderStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <StackPanel Width="220" Margin="0,0,8,0">
                            <TextBlock Text="Name" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Width="120" Margin="0,0,8,0">
                            <TextBlock Text="Price / MT (KES)" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewPrice, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Width="130" Margin="0,0,8,0">
                            <TextBlock Text="KES / USD" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ExchangeRateKesPerUsd, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.####}}"/>
                        </StackPanel>
                    </StackPanel>
                    <DockPanel Margin="0,0,0,10" LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                HorizontalAlignment="Right"
                                Margin="6,0,0,0"
                                Command="{Binding ImportPricesCommand}"
                                ToolTip="Import raw material prices from Excel (KES per MT)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" Style="{StaticResource ToolbarGlyphStyle}"/>
                                <TextBlock Text="Import" Style="{StaticResource ToolbarLabelStyle}"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                HorizontalAlignment="Right"
                                Command="{Binding DownloadImportSampleCommand}"
                                ToolTip="Download Excel sample format for raw material price import">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource ToolbarGlyphStyle}"/>
                                <TextBlock Text="Sample" Style="{StaticResource ToolbarLabelStyle}"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Style="{StaticResource ToolbarClusterStyle}" HorizontalAlignment="Left">
                            <Button Style="{StaticResource ToolbarPrimaryIconButtonStyle}"
                                    Command="{Binding AddCommand}"
                                    ToolTip="Add raw ingredient">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource ToolbarGlyphStyle}"/>
                                    <TextBlock Text="Add" Style="{StaticResource ToolbarLabelStyle}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarIconButtonStyle}" Margin="6,0,0,0"
                                    Command="{Binding SaveCommand}"
                                    ToolTip="Save changes">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource ToolbarGlyphStyle}"/>
                                    <TextBlock Text="Save" Style="{StaticResource ToolbarLabelStyle}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarDangerIconButtonStyle}" Margin="6,0,0,0"
                                    Command="{Binding RemoveCommand}"
                                    ToolTip="Remove selected raw ingredient">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource ToolbarGlyphStyle}"/>
                                    <TextBlock Text="Remove" Style="{StaticResource ToolbarLabelStyle}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarIconButtonStyle}" Margin="6,0,0,0"
                                    Command="{Binding LoadCommand}"
                                    ToolTip="Refresh list">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource ToolbarGlyphStyle}"/>
                                    <TextBlock Text="Refresh" Style="{StaticResource ToolbarLabelStyle}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarIconButtonStyle}" Margin="6,0,0,0"
                                    x:Name="ResetFiltersButton" Click="ResetFiltersButton_OnClick"
                                    ToolTip="Reset filters">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71C;" Style="{StaticResource ToolbarGlyphStyle}"/>
                                    <TextBlock Text="Reset" Style="{StaticResource ToolbarLabelStyle}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarIconButtonStyle}" Margin="6,0,0,0"
                                    Command="{Binding ShowHistoryCommand}"
                                    ToolTip="View recorded price changes for the selected raw material">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81C;" Style="{StaticResource ToolbarGlyphStyle}"/>
                                    <TextBlock Text="History" Style="{StaticResource ToolbarLabelStyle}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#F7F5F1" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="KES decimals" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" FontSize="12"/>
                                <Button Content="−" Width="28" Height="26" Padding="0" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding DecrementKesDecimalsCommand}"/>
                                <TextBlock Text="{Binding KesDecimalPlaces}" Width="18" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <Button Content="+" Width="28" Height="26" Padding="0" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding IncrementKesDecimalsCommand}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F7F5F1" CornerRadius="6" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="USD decimals" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" FontSize="12"/>
                                <Button Content="−" Width="28" Height="26" Padding="0" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding DecrementUsdDecimalsCommand}"/>
                                <TextBlock Text="{Binding UsdDecimalPlaces}" Width="18" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <Button Content="+" Width="28" Height="26" Padding="0" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding IncrementUsdDecimalsCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0" Padding="10"
                        MaxHeight="240"
                        Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding HideHistoryCommand}" Padding="10,2"/>
                            <TextBlock Text="{Binding HistoryTitle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding HistoryItems}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Changed (local)" Binding="{Binding ChangedAtLocal, StringFormat={}{0:dd MMM yyyy HH:mm}}" Width="160"/>
                                <DataGridTextColumn Header="Price / MT (KES)" Binding="{Binding PricePerMtKes, StringFormat={}{0:N2}}" Width="130"/>
                                <DataGridTextColumn Header="Price / MT (USD)" Binding="{Binding PricePerMtUsd, StringFormat={}{0:N2}}" Width="130"/>
                                <DataGridTextColumn Header="KES / USD" Binding="{Binding ExchangeRateKesPerUsd, StringFormat={}{0:0.####}}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <DataGrid x:Name="IngredientsGrid"
                          ItemsSource="{Binding FilteredItems}"
                          SelectedItem="{Binding SelectedItem}"
                          Loaded="IngredientsGrid_OnLoaded"
                          Unloaded="IngredientsGrid_OnUnloaded">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="320" MinWidth="160">
                            <DataGridTextColumn.Header>
                                <controls:ExcelColumnFilterHeader Title="Name" ColumnKey="Name"
                                                                  Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding PricePerMt, UpdateSourceTrigger=LostFocus, Converter={StaticResource CurrencyDecimalFormat}, ConverterParameter=kes}"
                                            Width="130" MinWidth="100">
                            <DataGridTextColumn.Header>
                                <controls:ExcelColumnFilterHeader Title="Price / MT (KES)" ColumnKey="PricePerMtKes" AllowValueFilter="False"
                                                                  Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding PricePerMtUsd, Converter={StaticResource CurrencyDecimalFormat}, ConverterParameter=usd}"
                                            Width="130" MinWidth="100" IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <controls:ExcelColumnFilterHeader Title="Price / MT (USD)" ColumnKey="PricePerMtUsd" AllowValueFilter="False"
                                                                  Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridCheckBoxColumn Binding="{Binding IsAvailable, UpdateSourceTrigger=PropertyChanged}" Width="100" MinWidth="80">
                            <DataGridCheckBoxColumn.Header>
                                <controls:ExcelColumnFilterHeader Title="Available" ColumnKey="Available"
                                                                  Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </DataGridCheckBoxColumn.Header>
                        </DataGridCheckBoxColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
