<Window x:Class="CostWise.App.Views.NutritionProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CostWise.App.Controls"
        Title="{Binding Title}"
        Height="560" Width="560"
        MinHeight="400" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ContentBgBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ToolbarIconButtonStyle}"
                        Command="{Binding ToggleCompareSelectionCommand}"
                        ToolTip="{Binding CompareToggleLabel}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource ToolbarGlyphStyle}"/>
                        <TextBlock Text="{Binding CompareToggleLabel}" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarPrimaryIconButtonStyle}" Margin="6,0,0,0"
                        Command="{Binding CompareNowCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        IsEnabled="{Binding CanCompareNow}"
                        ToolTip="Open Comparison with selected profiles">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D2;" Style="{StaticResource ToolbarGlyphStyle}"/>
                        <TextBlock Text="Compare" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <Button Style="{StaticResource ToolbarIconButtonStyle}"
                    HorizontalAlignment="Left"
                    Command="{Binding ResetAllFiltersCommand}"
                    ToolTip="Clear all filters">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE71C;" Style="{StaticResource ToolbarGlyphStyle}"/>
                    <TextBlock Text="Reset" Style="{StaticResource ToolbarLabelStyle}"/>
                </StackPanel>
            </Button>
        </DockPanel>

        <DataGrid ItemsSource="{Binding FilteredLines}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  ColumnHeaderHeight="44">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="*" MinWidth="160">
                    <DataGridTextColumn.Header>
                        <controls:ExcelColumnFilterHeader Title="Nutrient" ColumnKey="Nutrient"
                                                          Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Unit}" IsReadOnly="True" Width="80" MinWidth="50">
                    <DataGridTextColumn.Header>
                        <controls:ExcelColumnFilterHeader Title="Unit" ColumnKey="Unit"
                                                          Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTemplateColumn Width="100" MinWidth="70">
                    <DataGridTemplateColumn.Header>
                        <controls:ExcelColumnFilterHeader Title="Value" ColumnKey="Value"
                                                          Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TargetText}" VerticalAlignment="Center" Margin="4,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
