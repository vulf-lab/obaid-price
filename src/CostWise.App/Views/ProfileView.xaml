<UserControl x:Class="CostWise.App.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource AccentBrush}"
                       Margin="0,0,0,12"
                       TextWrapping="Wrap"/>

            <!-- Account -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Account" Style="{StaticResource SettingsSectionTitleStyle}"/>
                    <TextBlock Text="Email" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,4"/>
                    <TextBox Text="{Binding Email}" IsReadOnly="True" Background="#F7F5F1"/>

                    <TextBlock Text="Display name" Foreground="{StaticResource TextMutedBrush}" Margin="0,14,0,4"/>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="Save"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="8,0,0,0"
                                Command="{Binding SaveDisplayNameCommand}"/>
                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <TextBlock Text="Last login" Foreground="{StaticResource TextMutedBrush}" Margin="0,14,0,4"/>
                    <TextBlock Text="{Binding LastLoginText}" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Change password -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Change password" Style="{StaticResource SettingsSectionTitleStyle}"/>
                    <TextBlock Text="Current password" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,4"/>
                    <PasswordBox x:Name="CurrentPasswordBox" Margin="0,0,0,10"
                                 Padding="8,6" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"/>
                    <TextBlock Text="New password" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="NewPasswordBox" Margin="0,0,0,10"
                                 Padding="8,6" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"/>
                    <TextBlock Text="Confirm new password" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,14"
                                 Padding="8,6" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"/>
                    <Button Content="Update password"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Click="UpdatePassword_OnClick"/>
                </StackPanel>
            </Border>

            <!-- PIN -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="PIN unlock" Style="{StaticResource SettingsSectionTitleStyle}"/>
                    <TextBlock Text="Optional 4–8 digit PIN. When Remember me is on and a PIN is set, the app asks for this PIN on launch instead of your password."
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,12"/>
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="PIN status: Not set"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPin}" Value="True">
                                        <Setter Property="Text" Value="PIN status: Enabled"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Current password (required)"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PinCurrentPasswordBox" Margin="0,0,0,10"
                                 Padding="8,6" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"/>
                    <TextBlock Text="New PIN" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="NewPinBox" Margin="0,0,0,10" MaxLength="8"
                                 Padding="8,6" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"/>
                    <TextBlock Text="Confirm PIN" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="ConfirmPinBox" Margin="0,0,0,14" MaxLength="8"
                                 Padding="8,6" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save PIN"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SavePin_OnClick"/>
                        <Button Content="Clear PIN"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0"
                                Click="ClearPin_OnClick"
                                IsEnabled="{Binding HasPin}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Session -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Session" Style="{StaticResource SettingsSectionTitleStyle}"/>
                    <TextBlock Text="Sign out clears Remember me and returns to the login screen."
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,14"/>
                    <Button Content="Sign out"
                            Style="{StaticResource DangerButtonStyle}"
                            HorizontalAlignment="Left"
                            Command="{Binding SignOutCommand}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
