<UserControl x:Class="CostWise.App.Views.NutritionProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                   Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource ToolbarIconButtonStyle}"
                    HorizontalAlignment="Right"
                    Margin="6,0,0,0"
                    Command="{Binding ImportNutritionCommand}"
                    ToolTip="Import nutrition profiles from Excel">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8E5;" Style="{StaticResource ToolbarGlyphStyle}"/>
                    <TextBlock Text="Import" Style="{StaticResource ToolbarLabelStyle}"/>
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource ToolbarIconButtonStyle}"
                    HorizontalAlignment="Right"
                    Command="{Binding DownloadImportSampleCommand}"
                    ToolTip="Download Excel sample format for nutrition profile import">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A5;" Style="{StaticResource ToolbarGlyphStyle}"/>
                    <TextBlock Text="Sample" Style="{StaticResource ToolbarLabelStyle}"/>
                </StackPanel>
            </Button>
            <StackPanel Style="{StaticResource ToolbarClusterStyle}" HorizontalAlignment="Left">
                <Button Style="{StaticResource ToolbarPrimaryIconButtonStyle}"
                        Command="{Binding SaveCommand}"
                        ToolTip="Save nutrition profile(s)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource ToolbarGlyphStyle}"/>
                        <TextBlock Text="Save" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarIconButtonStyle}" Margin="6,0,0,0"
                        Command="{Binding LoadCommand}"
                        ToolTip="Refresh">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource ToolbarGlyphStyle}"/>
                        <TextBlock Text="Refresh" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarIconButtonStyle}" Margin="6,0,0,0"
                        Command="{Binding CompareCommand}"
                        IsEnabled="{Binding CanCompareProfiles}"
                        ToolTip="Compare selected profiles (2–10)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D2;" Style="{StaticResource ToolbarGlyphStyle}"/>
                        <TextBlock Text="Compare" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarIconButtonStyle}" Margin="6,0,0,0"
                        Command="{Binding ResetAllFiltersCommand}"
                        ToolTip="Clear all filters">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71C;" Style="{StaticResource ToolbarGlyphStyle}"/>
                        <TextBlock Text="Reset" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
                <Grid Margin="6,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="ColumnsButton"
                            Style="{StaticResource ToolbarIconButtonStyle}"
                            Click="ColumnsButton_OnClick"
                            ToolTip="Show or hide columns">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" Style="{StaticResource ToolbarGlyphStyle}"/>
                            <TextBlock Text="Columns" Style="{StaticResource ToolbarLabelStyle}"/>
                        </StackPanel>
                    </Button>
                    <Popup x:Name="ColumnsPopup"
                           PlacementTarget="{Binding ElementName=ColumnsButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource BorderSoftBrush}"
                                BorderThickness="1"
                                Padding="12"
                                MaxHeight="420"
                                MinWidth="220">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Show columns" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ColumnTogglesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Header}"
                                                          IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanToggle}"
                                                          Margin="0,2"
                                                          Checked="ColumnToggle_OnChanged"
                                                          Unchecked="ColumnToggle_OnChanged"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>
        </DockPanel>

        <Border Style="{StaticResource CardBorderStyle}">
            <DataGrid x:Name="MatrixGrid"
                      ItemsSource="{Binding FilteredMatrixRows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"
                      EnableColumnVirtualization="True"
                      EnableRowVirtualization="True"
                      ColumnHeaderHeight="76"
                      Loaded="MatrixGrid_OnLoaded"
                      Unloaded="MatrixGrid_OnUnloaded"
                      MouseDoubleClick="MatrixGrid_OnMouseDoubleClick">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
