<UserControl x:Class="CostWise.App.Views.ProductionMatrixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button Content="New group" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NewGroupCommand}"/>
                        <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0" Command="{Binding RefreshCommand}"/>
                        <Button Content="Delete group" Style="{StaticResource DangerButtonStyle}" Margin="0,8,0,0" Command="{Binding DeleteGroupCommand}"/>
                        <Button Content="Export Excel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0" Command="{Binding ExportExcelCommand}"/>
                        <Button Content="Export PDF" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0" Command="{Binding ExportPdfCommand}"/>
                        <TextBlock Text="Drag groups to reorder"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Groups" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ListBox x:Name="GroupsList"
                             ItemsSource="{Binding Groups}"
                             SelectedItem="{Binding SelectedGroup}"
                             DisplayMemberPath="Name"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="GroupsList_OnPreviewMouseLeftButtonDown"
                             PreviewMouseMove="GroupsList_OnPreviewMouseMove"
                             Drop="GroupsList_OnDrop"
                             DragOver="GroupsList_OnDragOver"/>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Select formulas" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenFormulaPickerCommand}"/>
                            <TextBlock Text="Production groups (view only)" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Group name" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox x:Name="GroupNameBox"
                                     Width="280"
                                     Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                     LostFocus="GroupNameBox_OnLostFocus"
                                     KeyDown="GroupNameBox_OnKeyDown"/>
                            <TextBlock Text="{Binding SelectionCountText}"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding TotalsSummary}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="Inclusion % is read-only here. Edit recipes on the Formulations page."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <DataGrid x:Name="MatrixGrid"
                              ItemsSource="{Binding Rows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              SelectionUnit="Cell"
                              FrozenColumnCount="1"
                              EnableColumnVirtualization="False"
                              EnableRowVirtualization="True"/>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <TextBlock Text="Create or select a production group, then click Select formulas to choose columns."
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
