<Window x:Class="CostWise.App.Views.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update available"
        Width="480"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="A newer version of OBAID Pricing is available."
               FontSize="16"
               FontWeight="SemiBold"
               TextWrapping="Wrap"
               Margin="0,0,0,12"/>

    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBlock x:Name="CurrentVersionText" Margin="0,0,0,4"/>
      <TextBlock x:Name="NewVersionText" FontWeight="SemiBold"/>
    </StackPanel>

    <Border Grid.Row="2"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            Padding="8"
            Margin="0,0,0,16">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="NotesText" TextWrapping="Wrap"/>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Skip this version"
              Width="130"
              Margin="0,0,8,0"
              Click="Skip_Click"
              Padding="10,6"/>
      <Button Content="Later"
              Width="90"
              Margin="0,0,8,0"
              Click="Later_Click"
              Padding="10,6"/>
      <Button Content="Update now"
              Width="110"
              IsDefault="True"
              Click="UpdateNow_Click"
              Padding="10,6"/>
    </StackPanel>
  </Grid>
</Window>
