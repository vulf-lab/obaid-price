<UserControl x:Class="CostWise.App.Views.ActivePricingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CostWise.App.Controls">
    <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button Content="New book" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NewBookCommand}"/>
                        <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0" Command="{Binding RefreshCommand}"/>
                        <Button Content="Delete" Style="{StaticResource DangerButtonStyle}" Margin="0,8,0,0" Command="{Binding DeleteBookCommand}"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Price books" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ListBox x:Name="BooksList"
                             ItemsSource="{Binding Books}"
                             SelectedItem="{Binding SelectedBook}"
                             DisplayMemberPath="Name"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="BooksList_OnPreviewMouseLeftButtonDown"
                             PreviewMouseMove="BooksList_OnPreviewMouseMove"
                             Drop="BooksList_OnDrop"
                             DragOver="BooksList_OnDragOver"/>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Select formulas" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding OpenFormulaPickerCommand}" Margin="0,0,8,0"/>
                                <Button Content="Save book" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveBookCommand}"/>
                            </StackPanel>
                            <TextBlock Text="Book settings" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Name" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Packing (required)" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox ItemsSource="{Binding PackingChoices}"
                                          SelectedItem="{Binding SelectedPackingChoice}"
                                          DisplayMemberPath="Label"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Transport (optional)" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding EditTransportationCost, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Additive (optional)" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox ItemsSource="{Binding AdditiveChoices}"
                                          SelectedItem="{Binding SelectedAdditiveChoice}"
                                          DisplayMemberPath="Label"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                <TextBlock Text="Export docs (optional)" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox ItemsSource="{Binding DocumentChoices}"
                                          SelectedItem="{Binding SelectedDocumentChoice}"
                                          DisplayMemberPath="Label"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                <TextBlock Text="Currency" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox ItemsSource="{Binding Currencies}"
                                          SelectedItem="{Binding SelectedDisplayCurrency}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding Code}"/>
                                                <Run Text=" — "/>
                                                <Run Text="{Binding Name}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,12,0,0">
                                <TextBlock Text="Margin %" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding EditMarginPercent, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="6" Margin="0,12,0,0"
                                       Text="{Binding SelectionCountText}"
                                       VerticalAlignment="Bottom"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>

                            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                <TextBlock Text="Round MT to" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding EditRoundMtTo, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                                <TextBlock Text="Round bag to" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding EditRoundBagTo, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="3" Margin="0,12,0,0"
                                       Text="Margin % is gross margin on sell. Manual MT or bag updates both (40 bags/MT). Changing Margin % clears manuals."
                                       VerticalAlignment="Bottom"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid DockPanel.Dock="Right" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Reset all filters" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ResetAllFiltersCommand}" Margin="0,0,8,0"/>
                                    <Button x:Name="ColumnsButton"
                                            Content="Columns"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ColumnsButton_OnClick"
                                            Padding="12,4"/>
                                </StackPanel>
                                <Popup x:Name="ColumnsPopup"
                                       PlacementTarget="{Binding ElementName=ColumnsButton}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True">
                                    <Border Background="{StaticResource CardBgBrush}"
                                            BorderBrush="{StaticResource BorderSoftBrush}"
                                            BorderThickness="1"
                                            Padding="12"
                                            MinWidth="200">
                                        <StackPanel>
                                            <TextBlock Text="Show columns" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBlock Text="Drag column headers to rearrange"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,0,0,8"
                                                       TextWrapping="Wrap"/>
                                            <ItemsControl x:Name="ColumnTogglesList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Header}"
                                                                  IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CanToggle}"
                                                                  Margin="0,2"
                                                                  Checked="ColumnToggle_OnChanged"
                                                                  Unchecked="ColumnToggle_OnChanged"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding CostsHeaderText}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Drag rows to reorder formulas · drag headers to rearrange columns · Packing required to save"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Visibility="{Binding HasFormulas, Converter={StaticResource BoolToVisibility}}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>

                        <DataGrid x:Name="ActivePricesGrid"
                                  ItemsSource="{Binding FilteredRows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="True"
                                  ColumnHeaderHeight="44"
                                  RowHeaderWidth="0"
                                  AllowDrop="{Binding CanReorderRows}"
                                  Visibility="{Binding HasFormulas, Converter={StaticResource BoolToVisibility}}"
                                  PreviewMouseLeftButtonDown="ActivePricesGrid_OnPreviewMouseLeftButtonDown"
                                  PreviewMouseMove="ActivePricesGrid_OnPreviewMouseMove"
                                  DragOver="ActivePricesGrid_OnDragOver"
                                  Drop="ActivePricesGrid_OnDrop"
                                  Loaded="ActivePricesGrid_OnLoaded"
                                  Unloaded="ActivePricesGrid_OnUnloaded"
                                  CellEditEnding="ActivePricesGrid_OnCellEditEnding">
                            <DataGrid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                </Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Code}" Width="100" MinWidth="80" IsReadOnly="True">
                                    <DataGridTextColumn.Header>
                                        <controls:ExcelColumnFilterHeader Title="Code" ColumnKey="Code"
                                                                          Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Width="150" MinWidth="130" IsReadOnly="True">
                                    <DataGridTemplateColumn.Header>
                                        <controls:ExcelColumnFilterHeader Title="Production" ColumnKey="Production"
                                                                          Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Not in Production"/>
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInProduction}" Value="True">
                                                                <Setter Property="Text" Value="In Production"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                <Setter Property="FontWeight" Value="Normal"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Binding="{Binding CategoryName}" Width="130" MinWidth="110" IsReadOnly="True">
                                    <DataGridTextColumn.Header>
                                        <controls:ExcelColumnFilterHeader Title="Category" ColumnKey="Category"
                                                                          Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding FeedTypeName}" Width="130" MinWidth="110" IsReadOnly="True">
                                    <DataGridTextColumn.Header>
                                        <controls:ExcelColumnFilterHeader Title="Feed type" ColumnKey="FeedType"
                                                                          Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding SubCategoryName}" Width="90" MinWidth="70" IsReadOnly="True">
                                    <DataGridTextColumn.Header>
                                        <controls:ExcelColumnFilterHeader Title="Version" ColumnKey="Version"
                                                                          Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="120" MinWidth="110" IsReadOnly="True">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding Converter="{StaticResource DisplayCurrencyMoney}">
                                            <Binding Path="RmCost"/>
                                            <Binding Path="DataContext.SelectedDisplayCurrency.Code" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                    <DataGridTextColumn.Header>
                                        <controls:ExcelColumnFilterHeader Title="Raw Material" ColumnKey="Raw Material" AllowValueFilter="False"
                                                                          Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="110" MinWidth="100" IsReadOnly="True">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding Converter="{StaticResource DisplayCurrencyMoney}">
                                            <Binding Path="ConversionCost"/>
                                            <Binding Path="DataContext.SelectedDisplayCurrency.Code" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                    <DataGridTextColumn.Header>
                                        <controls:ExcelColumnFilterHeader Title="Conversion" ColumnKey="Conversion" AllowValueFilter="False"
                                                                          Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="110" MinWidth="100" IsReadOnly="True">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding Converter="{StaticResource DisplayCurrencyMoney}">
                                            <Binding Path="PackingCost"/>
                                            <Binding Path="DataContext.SelectedDisplayCurrency.Code" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                    <DataGridTextColumn.Header>
                                        <controls:ExcelColumnFilterHeader Title="Packing cost" ColumnKey="Packing cost" AllowValueFilter="False"
                                                                          Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="100" MinWidth="80" IsReadOnly="True">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding Converter="{StaticResource DisplayCurrencyMoney}">
                                            <Binding Path="AdditiveCost"/>
                                            <Binding Path="DataContext.SelectedDisplayCurrency.Code" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                    <DataGridTextColumn.Header>
                                        <controls:ExcelColumnFilterHeader Title="Additive" ColumnKey="Additive" AllowValueFilter="False"
                                                                          Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="110" MinWidth="100" IsReadOnly="True">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding Converter="{StaticResource DisplayCurrencyMoney}">
                                            <Binding Path="ExportDocCost"/>
                                            <Binding Path="DataContext.SelectedDisplayCurrency.Code" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                    <DataGridTextColumn.Header>
                                        <controls:ExcelColumnFilterHeader Title="Export Doc" ColumnKey="Export Doc" AllowValueFilter="False"
                                                                          Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="110" MinWidth="90" IsReadOnly="True">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding Converter="{StaticResource DisplayCurrencyMoney}">
                                            <Binding Path="TotalCost"/>
                                            <Binding Path="DataContext.SelectedDisplayCurrency.Code" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                    <DataGridTextColumn.Header>
                                        <controls:ExcelColumnFilterHeader Title="Total cost" ColumnKey="Total cost" AllowValueFilter="False"
                                                                          Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="110" MinWidth="90" IsReadOnly="True">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding Converter="{StaticResource DisplayCurrencyMoney}" TargetNullValue="">
                                            <Binding Path="SellMt"/>
                                            <Binding Path="DataContext.SelectedDisplayCurrency.Code" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                    <DataGridTextColumn.Header>
                                        <controls:ExcelColumnFilterHeader Title="Sell / MT" ColumnKey="Sell / MT" AllowValueFilter="False"
                                                                          Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding OverrideSellMtText, UpdateSourceTrigger=LostFocus}" Width="100" MinWidth="90">
                                    <DataGridTextColumn.Header>
                                        <controls:ExcelColumnFilterHeader Title="Manual MT" ColumnKey="Manual MT" AllowValueFilter="False"
                                                                          Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="110" MinWidth="90" IsReadOnly="True">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding Converter="{StaticResource DisplayCurrencyMoney}" TargetNullValue="">
                                            <Binding Path="SellBag"/>
                                            <Binding Path="DataContext.SelectedDisplayCurrency.Code" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                    <DataGridTextColumn.Header>
                                        <controls:ExcelColumnFilterHeader Title="Sell / bag" ColumnKey="Sell / bag" AllowValueFilter="False"
                                                                          Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding OverrideSellBagText, UpdateSourceTrigger=LostFocus}" Width="100" MinWidth="90">
                                    <DataGridTextColumn.Header>
                                        <controls:ExcelColumnFilterHeader Title="Manual bag" ColumnKey="Manual bag" AllowValueFilter="False"
                                                                          Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding GrossMarginPercent, StringFormat={}{0:0.##}, TargetNullValue=-}" Width="120" MinWidth="110" IsReadOnly="True">
                                    <DataGridTextColumn.Header>
                                        <controls:ExcelColumnFilterHeader Title="Gross margin %" ColumnKey="Gross margin %" AllowValueFilter="False"
                                                                          Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="No formulas in this book - click Select formulas."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding HasFormulas, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <TextBlock Text="Create or select a price book, then click Select formulas to choose what to price."
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
