<UserControl x:Class="CostWise.App.Views.ActivePricingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button Content="New book" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NewBookCommand}"/>
                        <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0" Command="{Binding RefreshCommand}"/>
                        <Button Content="Delete" Style="{StaticResource DangerButtonStyle}" Margin="0,8,0,0" Command="{Binding DeleteBookCommand}"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Price books" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding Books}"
                             SelectedItem="{Binding SelectedBook}"
                             DisplayMemberPath="Name"/>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Save book" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveBookCommand}"/>
                            <TextBlock Text="Book settings" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Name" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Packing" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox ItemsSource="{Binding PackingChoices}"
                                          SelectedItem="{Binding SelectedPackingChoice}"
                                          DisplayMemberPath="Label"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Transport (optional)" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding EditTransportationCost, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Additive (optional)" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox ItemsSource="{Binding AdditiveChoices}"
                                          SelectedItem="{Binding SelectedAdditiveChoice}"
                                          DisplayMemberPath="Label"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                <TextBlock Text="Export docs (optional)" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox ItemsSource="{Binding DocumentChoices}"
                                          SelectedItem="{Binding SelectedDocumentChoice}"
                                          DisplayMemberPath="Label"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                <TextBlock Text="Margin %" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding EditMarginPercent, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,12,0,0">
                                <TextBlock Text="Unit" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox ItemsSource="{Binding PriceUnitOptions}"
                                          SelectedItem="{Binding SelectedPriceUnitOption}"
                                          DisplayMemberPath="Label"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding UnitLabel, StringFormat=Active formulations — prices per {0}}"
                                   FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <DataGrid x:Name="ActivePricesGrid"
                                  ItemsSource="{Binding Rows}"
                                  IsReadOnly="True"
                                  Loaded="ActivePricesGrid_OnLoaded"
                                  Unloaded="ActivePricesGrid_OnUnloaded">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="110" MinWidth="80"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="140" MinWidth="90"/>
                                <DataGridTextColumn Header="Version" Binding="{Binding SubCategoryName}" Width="100" MinWidth="70"/>
                                <DataGridTextColumn Header="RM" Binding="{Binding RmCost, Converter={StaticResource MoneyFormat}}" Width="100" MinWidth="70"/>
                                <DataGridTextColumn Header="Conversion" Binding="{Binding ConversionCost, Converter={StaticResource MoneyFormat}}" Width="100" MinWidth="70"/>
                                <DataGridTextColumn Header="Total cost" Binding="{Binding TotalCost, Converter={StaticResource MoneyFormat}}" Width="110" MinWidth="80"/>
                                <DataGridTextColumn Header="Sell price" Binding="{Binding SellingPrice, Converter={StaticResource MoneyFormat}}" Width="110" MinWidth="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <TextBlock Text="Create or select a price book to set shared costs and price all active formulations."
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
