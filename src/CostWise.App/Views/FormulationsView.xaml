<UserControl x:Class="CostWise.App.Views.FormulationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CostWise.App.Controls">
    <Grid>
        <!-- List -->
        <DockPanel Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
            <Border Style="{StaticResource CardBorderStyle}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                HorizontalAlignment="Right"
                                Margin="6,0,0,0"
                                Command="{Binding ImportFormulasCommand}"
                                ToolTip="Import formulations from Excel">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" Style="{StaticResource ToolbarGlyphStyle}"/>
                                <TextBlock Text="Import" Style="{StaticResource ToolbarLabelStyle}"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                HorizontalAlignment="Right"
                                Command="{Binding DownloadImportSampleCommand}"
                                ToolTip="Download Excel sample format for formulation import">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource ToolbarGlyphStyle}"/>
                                <TextBlock Text="Sample" Style="{StaticResource ToolbarLabelStyle}"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Style="{StaticResource ToolbarClusterStyle}" HorizontalAlignment="Left">
                            <Button Style="{StaticResource ToolbarPrimaryIconButtonStyle}"
                                    Command="{Binding NewCommand}"
                                    ToolTip="New formulation">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource ToolbarGlyphStyle}"/>
                                    <TextBlock Text="New" Style="{StaticResource ToolbarLabelStyle}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarDangerIconButtonStyle}" Margin="6,0,0,0"
                                    Command="{Binding DeleteCommand}"
                                    ToolTip="Delete selected formulation">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource ToolbarGlyphStyle}"/>
                                    <TextBlock Text="Delete" Style="{StaticResource ToolbarLabelStyle}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarIconButtonStyle}" Margin="6,0,0,0"
                                    Command="{Binding LoadCommand}"
                                    ToolTip="Refresh list">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource ToolbarGlyphStyle}"/>
                                    <TextBlock Text="Refresh" Style="{StaticResource ToolbarLabelStyle}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarIconButtonStyle}" Margin="6,0,0,0"
                                    Command="{Binding CompareCommand}"
                                    IsEnabled="{Binding CanCompareFormulations}"
                                    ToolTip="Compare selected formulations (2–10)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D2;" Style="{StaticResource ToolbarGlyphStyle}"/>
                                    <TextBlock Text="Compare" Style="{StaticResource ToolbarLabelStyle}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarIconButtonStyle}" Margin="6,0,0,0"
                                    Command="{Binding ResetAllFiltersCommand}"
                                    ToolTip="Reset all filters">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71C;" Style="{StaticResource ToolbarGlyphStyle}"/>
                                    <TextBlock Text="Reset" Style="{StaticResource ToolbarLabelStyle}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="FormulationsListGrid"
                              ItemsSource="{Binding FilteredItems}"
                              SelectedItem="{Binding SelectedItem}"
                              IsReadOnly="True"
                              MouseDoubleClick="FormulationsGrid_OnMouseDoubleClick"
                              Loaded="FormulationsListGrid_OnLoaded"
                              Unloaded="FormulationsListGrid_OnUnloaded">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="70" MinWidth="60" IsReadOnly="False">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="Compare" VerticalAlignment="Center"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsCompareSelected, Mode=OneWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ToolTip="Include in comparison (max 10)"
                                                  Command="{Binding DataContext.ToggleCompareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding SystemId}" Width="100" MinWidth="80">
                                <DataGridTextColumn.Header>
                                    <controls:ExcelColumnFilterHeader Title="System ID" ColumnKey="SystemId" AllowValueFilter="False"
                                                                      Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Code}" Width="110" MinWidth="80">
                                <DataGridTextColumn.Header>
                                    <controls:ExcelColumnFilterHeader Title="Code" ColumnKey="Code" AllowValueFilter="False"
                                                                      Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding FeedTypeName}" Width="130" MinWidth="90">
                                <DataGridTextColumn.Header>
                                    <controls:ExcelColumnFilterHeader Title="Feed type" ColumnKey="FeedType"
                                                                      Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding SpeciesName}" Width="90" MinWidth="70">
                                <DataGridTextColumn.Header>
                                    <controls:ExcelColumnFilterHeader Title="Species" ColumnKey="Species"
                                                                      Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding SizeName}" Width="70" MinWidth="50">
                                <DataGridTextColumn.Header>
                                    <controls:ExcelColumnFilterHeader Title="Size" ColumnKey="Size"
                                                                      Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding CategoryName}" Width="120" MinWidth="80">
                                <DataGridTextColumn.Header>
                                    <controls:ExcelColumnFilterHeader Title="Category" ColumnKey="Category"
                                                                      Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding SubCategoryName}" Width="70" MinWidth="50">
                                <DataGridTextColumn.Header>
                                    <controls:ExcelColumnFilterHeader Title="Version" ColumnKey="Version"
                                                                      Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Revision}" Width="60" MinWidth="40">
                                <DataGridTextColumn.Header>
                                    <controls:ExcelColumnFilterHeader Title="Rev" ColumnKey="Rev"
                                                                      Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding IsActive, Converter={StaticResource BoolToYesNo}}" Width="70" MinWidth="55">
                                <DataGridTextColumn.Header>
                                    <controls:ExcelColumnFilterHeader Title="Active" ColumnKey="Active"
                                                                      Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Width="80" MinWidth="70">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="Profile" VerticalAlignment="Center"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Open"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="8,2"
                                                HorizontalAlignment="Left"
                                                Command="{Binding DataContext.OpenProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Open nutrition profile for this code"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding RmCost, Converter={StaticResource MoneyFormat}}" Width="100" MinWidth="70">
                                <DataGridTextColumn.Header>
                                    <controls:ExcelColumnFilterHeader Title="RM cost" ColumnKey="RmCost" AllowValueFilter="False"
                                                                      Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Width="100" MinWidth="70">
                                <DataGridTemplateColumn.Header>
                                    <controls:ExcelColumnFilterHeader Title="Status" ColumnKey="Status"
                                                                      Host="{Binding DataContext.FilterHost, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock ToolTip="{Binding UnavailableMaterials}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Producible"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnfit}" Value="True">
                                                            <Setter Property="Text" Value="Unfit"/>
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UnavailableMaterials}" Value="">
                                                            <Setter Property="ToolTip" Value="{x:Null}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- Detail: view or edit -->
        <DockPanel Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Edit" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding BeginEditCommand}"
                        Visibility="{Binding IsViewMode, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="Compare" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                        Command="{Binding CompareFromDetailCommand}"
                        IsEnabled="{Binding CanCompareFromDetail}"
                        ToolTip="Compare this formulation with others selected (2–10)"/>
                <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Command="{Binding CancelCommand}"/>
                <Button Content="Close" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Command="{Binding CloseDetailCommand}"
                        Visibility="{Binding IsViewMode, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource WarningBrush}"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="System ID" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock FontWeight="SemiBold" Text="{Binding EditSystemId}" VerticalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,8,8">
                                <TextBlock Text="Code" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCodeEditable}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,8,8">
                                <TextBlock Text="Feed type" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox ItemsSource="{Binding FeedTypes}" SelectedItem="{Binding EditFeedType}" DisplayMemberPath="Name" IsEnabled="{Binding IsEditMode}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="8,0,0,8">
                                <TextBlock Text="Species" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox ItemsSource="{Binding SpeciesOptions}" SelectedItem="{Binding EditSpecies}" DisplayMemberPath="Name" IsEnabled="{Binding IsEditMode}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,0,8,8">
                                <TextBlock Text="Size" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox ItemsSource="{Binding Sizes}" SelectedItem="{Binding EditSize}" DisplayMemberPath="Name" IsEnabled="{Binding IsEditMode}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,8,8">
                                <TextBlock Text="Category" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding EditCategory}" DisplayMemberPath="Name" IsEnabled="{Binding IsEditMode}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="8,0,8,8">
                                <TextBlock Text="Version (sub category)" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox ItemsSource="{Binding SubCategories}" SelectedItem="{Binding EditSubCategory}" DisplayMemberPath="Name" IsEnabled="{Binding IsEditMode}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="3" Margin="8,0,0,8">
                                <TextBlock Text="Revision" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding EditRevision, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditMode}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="0,0,8,0">
                                <TextBlock Text="Total inclusion %" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock FontSize="18" FontWeight="SemiBold"
                                           Text="{Binding TotalInclusion, StringFormat={}{0:N2} %}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,8,0">
                                <TextBlock Text="Live RM cost / MT" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding LiveRmCost, Converter={StaticResource MoneyFormat}}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="8,0,8,0">
                                <TextBlock Text="Created (UTC)" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding EditCreatedAtUtc, StringFormat=yyyy-MM-dd HH:mm}" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="3" Margin="8,0,0,0">
                                <TextBlock Text="Updated (UTC)" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding EditUpdatedAtUtc, StringFormat=yyyy-MM-dd HH:mm}" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Margin="0,12,8,0">
                                <TextBlock Text="Imported (UTC)" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding EditImportedAtUtc, StringFormat=yyyy-MM-dd HH:mm, TargetNullValue=—}" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,12,8,0">
                                <TextBlock Text="In production (Active)" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Margin="0,8,0,0" FontWeight="SemiBold"
                                           Text="{Binding EditIsActive, Converter={StaticResource BoolToYesNo}}"/>
                                <TextBlock Text="Set by adding this formula to a Production group."
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid MinHeight="280">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"
                                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Ingredients" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="Raw ingredient" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextMutedBrush}"/>
                                    <ComboBox Width="200" ItemsSource="{Binding AvailableRawIngredients}" SelectedItem="{Binding SelectedRawToAdd}" DisplayMemberPath="Name"/>
                                    <Button Content="Add RM" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Command="{Binding AddIngredientLineCommand}"/>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Ingredients" FontWeight="SemiBold" Margin="0,0,0,8"
                                           Visibility="{Binding IsViewMode, Converter={StaticResource BoolToVisibility}}"/>
                                <DataGrid x:Name="IngredientsGrid"
                                          ItemsSource="{Binding IngredientLines}"
                                          IsReadOnly="{Binding IsViewMode}"
                                          Loaded="IngredientsGrid_OnLoaded"
                                          Unloaded="IngredientsGrid_OnUnloaded">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Raw ingredient" Width="280" MinWidth="140" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding RawIngredientName}" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Inclusion %" Binding="{Binding InclusionPercent, UpdateSourceTrigger=PropertyChanged}" Width="90" MinWidth="70"/>
                                        <DataGridTextColumn Header="Price / MT" Binding="{Binding PricePerMt, Converter={StaticResource MoneyFormat}}" IsReadOnly="True" Width="90" MinWidth="70"/>
                                        <DataGridTextColumn Header="Line cost" Binding="{Binding LineCost, Converter={StaticResource MoneyFormat}}" IsReadOnly="True" Width="90" MinWidth="70"/>
                                        <DataGridCheckBoxColumn Header="Avail." Binding="{Binding IsAvailable}" IsReadOnly="True" Width="55" MinWidth="50"/>
                                        <DataGridTemplateColumn Width="80" MinWidth="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Remove" Style="{StaticResource DangerButtonStyle}"
                                                            Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"
                                                            Command="{Binding DataContext.RemoveIngredientLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"
                                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Nutrients" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="Nutrient" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextMutedBrush}"/>
                                    <ComboBox Width="140" ItemsSource="{Binding SpecParameters}" SelectedItem="{Binding SelectedSpecToAdd}" DisplayMemberPath="Name"/>
                                    <Button Content="Add" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Command="{Binding AddSpecLineCommand}"/>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Nutrients" FontWeight="SemiBold" Margin="0,0,0,8"
                                           Visibility="{Binding IsViewMode, Converter={StaticResource BoolToVisibility}}"/>
                                <DataGrid x:Name="SpecsGrid"
                                          ItemsSource="{Binding SpecLines}"
                                          IsReadOnly="{Binding IsViewMode}"
                                          Loaded="SpecsGrid_OnLoaded"
                                          Unloaded="SpecsGrid_OnUnloaded">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nutrient" Binding="{Binding SpecParameterName}" IsReadOnly="True" Width="160" MinWidth="100"/>
                                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" IsReadOnly="True" Width="55" MinWidth="40"/>
                                        <DataGridTemplateColumn Header="Target" Width="80" MinWidth="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding TargetText}" VerticalAlignment="Center" Margin="4,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}"
                                                             VerticalContentAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="70" MinWidth="50">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Remove" Style="{StaticResource DangerButtonStyle}"
                                                            Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"
                                                            Command="{Binding DataContext.RemoveSpecLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0" MaxHeight="180">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Change history" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <DataGrid x:Name="ChangeLogsGrid"
                                      ItemsSource="{Binding ChangeLogs}"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      Loaded="ChangeLogsGrid_OnLoaded"
                                      Unloaded="ChangeLogsGrid_OnUnloaded">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="When (UTC)" Binding="{Binding ChangedAtUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="140" MinWidth="100"/>
                                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="90" MinWidth="70"/>
                                    <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="400" MinWidth="160"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
